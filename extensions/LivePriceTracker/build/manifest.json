{
  "manifest_version": 3,
  "name": "Dhan Price Sync",
  "version": "1.0",
  "description": "Injects live price into calculator",
  "permissions": ["scripting", "storage", "tabs", "activeTab"],
  "host_permissions": ["https://*.dhan.co/*"],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["priceTracker.css"],
      "matches": ["https://*.dhan.co/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://web.dhan.co/index/indices*", "https://tv.dhan.co/*"],
      "js": ["content.js"],
      "css": ["priceTracker.css"],
      "run_at": "document_end",
      "all_frames": true
    }
  ]
}
